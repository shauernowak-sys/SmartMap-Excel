    {"header":"外币金额","source":null,"kind":"money","required":false},
    {"header":"客户","source":"auxiliary.customer","kind":"text","required":false},
    {"header":"供应商","source":"auxiliary.supplier","kind":"text","required":false},
    {"header":"部门","source":"auxiliary.department","kind":"text","required":false},
    {"header":"员工","source":"auxiliary.employee","kind":"text","required":false},
    {"header":"存货名称","source":"auxiliary.stock_name","kind":"text","required":false},
