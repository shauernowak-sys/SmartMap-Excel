    {"header":"附件数","source":null,"kind":"integer","required":false},
    {"header":"项目","source":"auxiliary.project","kind":"text","required":false},
    {"header":"客户等级","source":"auxiliary.customer_level","kind":"text","required":false},
    {"header":"其他入库类别","source":"auxiliary.inbound_type","kind":"text","required":false},
    {"header":"其他出库类别","source":"auxiliary.outbound_type","kind":"text","required":false}
